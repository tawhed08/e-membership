PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
# Comma-separated production/staging frontend origins in addition to localhost.
CORS_ORIGINS=

# Optional: required to deliver scheduled expiry emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=E-Membership <no-reply@example.com>

# Optional hosted card checkout through aamarPay.
# Use sandbox credentials for development. Set false only for live credentials.
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_SANDBOX=true

# Optional: used by scripts/resetAdminPassword.ts.
ADMIN_EMAIL=admin@example.com
ADMIN_NEW_PASSWORD=replace-with-a-secure-password